# Local development only. Copy to .env and replace every secret (scripts/init-env.sh does it).
STORAGE_DATA_DIR=./data
STORAGE_NETWORK=baby-family-storage

VALKEY_PORT=6379
VALKEY_PASSWORD=change_me_valkey
VALKEY_MAXMEMORY=256mb

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=baby-root
MINIO_ROOT_PASSWORD=change_me_minio_root
# Least-privilege key the backend uses (created by minio-init).
MINIO_APP_ACCESS_KEY=baby-backend
MINIO_APP_SECRET_KEY=change_me_minio_app

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
