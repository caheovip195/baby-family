NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://baby:baby_local_only@localhost:5433/baby_family?schema=public
# Only Compose uses this URL; its hostname is the database stack's network alias.
DATABASE_DOCKER_URL=postgresql://baby:baby_local_only@baby-postgres:5432/baby_family?schema=public
DATABASE_NETWORK=baby-family-data
DATABASE_POOL_SIZE=10
# ES256 SPKI PEM public key from the trusted authentication issuer. Use literal \n.
# No key is shipped; authenticated domain endpoints fail closed until configured.
# AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
AUTH_JWT_ISSUER=baby-family
AUTH_JWT_AUDIENCE=baby-family-app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info
SWAGGER_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
