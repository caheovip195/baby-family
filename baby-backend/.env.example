NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://baby:baby_local_only@localhost:5433/baby_family?schema=public
# Only Compose uses this URL; its hostname is the database stack's network alias.
DATABASE_DOCKER_URL=postgresql://baby:baby_local_only@baby-postgres:5432/baby_family?schema=public
DATABASE_NETWORK=baby-family-data
DATABASE_POOL_SIZE=10
# ES256 SPKI PEM public key from the trusted authentication issuer. Use literal \n.
# No key is shipped; authenticated domain endpoints fail closed until configured.
# AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
AUTH_JWT_ISSUER=baby-family
AUTH_JWT_AUDIENCE=baby-family-app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info
SWAGGER_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Supporting services from ../baby-storage (scripts/init-env.sh). Copy matching secrets from
# baby-storage/.env. Host URLs for `npm run start:dev`; *_DOCKER_* for backend Compose.
# All optional: leave empty to disable (readiness reports `disabled`, features return 503).
STORAGE_NETWORK=baby-family-storage
REDIS_URL=redis://:change_me_valkey@localhost:6379/0
REDIS_DOCKER_URL=redis://:change_me_valkey@baby-valkey:6379/0
S3_ENDPOINT=http://localhost:9000
S3_DOCKER_ENDPOINT=http://baby-minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=baby-backend
S3_SECRET_ACCESS_KEY=change_me_minio_app
S3_FORCE_PATH_STYLE=true
SMTP_HOST=localhost
SMTP_DOCKER_HOST=baby-mailpit
SMTP_PORT=1025
# Local Mailpit only: lets the production-mode Compose API use plaintext SMTP.
SMTP_ALLOW_INSECURE=true
# Optional (defaults shown). Production SMTP must set SMTP_SECURE or SMTP_REQUIRE_TLS=true
# (SMTP_ALLOW_INSECURE=true is only for the local Mailpit sink).
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Baby Family <no-reply@babyfamily.local>
# S3_BUCKET_MEDIA=bf-media
# S3_BUCKET_USER_MEDIA=bf-user-media
# S3_BUCKET_EXPORTS=bf-exports
# S3_BUCKET_PUBLIC=bf-public
