NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://baby:baby_local_only@localhost:5433/baby_family?schema=public
# Only Compose uses this URL; its hostname is the database stack's network alias.
DATABASE_DOCKER_URL=postgresql://baby:baby_local_only@baby-postgres:5432/baby_family?schema=public
DATABASE_NETWORK=baby-family-data
DATABASE_POOL_SIZE=10
# ES256 SPKI PEM public key from the trusted authentication issuer. Use literal \n.
# No key is shipped; authenticated domain endpoints fail closed until configured.
# AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
AUTH_JWT_ISSUER=baby-family
AUTH_JWT_AUDIENCE=baby-family-app
# Token issuance (spec §5.1): ES256 PKCS#8 private key (literal \n). The verifying key is
# derived from it when AUTH_JWT_PUBLIC_KEY is empty. Without it sign-in endpoints return 503.
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | openssl pkcs8 -topk8 -nocrypt
# AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# HMAC pepper (>= 32 chars) for phone/OTP/invite-code/identity hashes; never rotate casually.
# AUTH_SECRET_PEPPER=change_me_at_least_32_characters_long
# Papa & Mama check-in notes are encrypted with this root key (32 bytes, base64); never rotate casually.
#   openssl rand -base64 32
# COUPLE_CHECKIN_ENCRYPTION_KEY=
# Support ticket content (help desk) — separate 32-byte base64 key, same rules.
# SUPPORT_ENCRYPTION_KEY=
# Sign in with Apple / Google (each provider opt-in; any field missing → 503 AUTH_PROVIDER_UNAVAILABLE).
# AUTH_APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
# AUTH_APPLE_ISSUER=https://appleid.apple.com
# AUTH_APPLE_CLIENT_ID=
# AUTH_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# AUTH_GOOGLE_ISSUER=https://accounts.google.com
# AUTH_GOOGLE_CLIENT_ID=
# In-app purchases (store verification/webhooks). Store products must exist in the plan catalog.
# IAP_ENVIRONMENT=SANDBOX
# APP_STORE_BUNDLE_ID=
# APP_STORE_ROOT_CERTIFICATES_JSON=["-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"]
# PLAY_PACKAGE_NAME=
# PLAY_WEBHOOK_TOKEN=
# IAP_PAYLOAD_ENCRYPTION_KEY=   # 32 bytes base64: openssl rand -base64 32
# OTP delivery: `mail` writes codes to Mailpit (http://localhost:8025). Development only.
AUTH_OTP_DELIVERY=mail
AUTH_OTP_MAIL_TO=otp-inbox@babyfamily.local
# The local Compose API is a production build; allow the Mailpit OTP sink there explicitly.
AUTH_OTP_ALLOW_MAIL_IN_PRODUCTION=true
INVITE_LINK_BASE_URL=https://babyfamily.vn/i/
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info
SWAGGER_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Supporting services from ../baby-storage (scripts/init-env.sh). Copy matching secrets from
# baby-storage/.env. Host URLs for `npm run start:dev`; *_DOCKER_* for backend Compose.
# All optional: leave empty to disable (readiness reports `disabled`, features return 503).
STORAGE_NETWORK=baby-family-storage
REDIS_URL=redis://:change_me_valkey@localhost:6379/0
REDIS_DOCKER_URL=redis://:change_me_valkey@baby-valkey:6379/0
S3_ENDPOINT=http://localhost:9000
S3_DOCKER_ENDPOINT=http://baby-minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=baby-backend
S3_SECRET_ACCESS_KEY=change_me_minio_app
S3_FORCE_PATH_STYLE=true
SMTP_HOST=localhost
SMTP_DOCKER_HOST=baby-mailpit
SMTP_PORT=1025
# Local Mailpit only: lets the production-mode Compose API use plaintext SMTP.
SMTP_ALLOW_INSECURE=true
# Optional (defaults shown). Production SMTP must set SMTP_SECURE or SMTP_REQUIRE_TLS=true
# (SMTP_ALLOW_INSECURE=true is only for the local Mailpit sink).
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Baby Family <no-reply@babyfamily.local>
# S3_BUCKET_MEDIA=bf-media
# S3_BUCKET_USER_MEDIA=bf-user-media
# S3_BUCKET_EXPORTS=bf-exports
# S3_BUCKET_PUBLIC=bf-public

# FCM HTTP v1: leave all unset to disable push. Set project + exactly one JSON source.
# Credentials stay server-side. Tests always use the disabled adapter.
# FCM_PROJECT_ID=your-firebase-project
# FCM_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json

# Observability (docs/observability.md): structured logs and a token-protected /metrics.
# LOG_FORMAT=json            # json | pretty
# LOG_LEVEL=info
# METRICS_TOKEN=             # ≥ 32 chars; unset → /metrics is not exposed
# ERROR_REPORTING_DSN=

# Admin CMS (/admin/v1, separate auth): 32-byte base64 keys (openssl rand -base64 32).
# ADMIN_CMS_TOTP_ENCRYPTION_KEY=
# ADMIN_CMS_TOKEN_SECRET=
# First admin (one-off command, never seeded): ADMIN_CREATE_EMAIL=… ADMIN_CREATE_PASSWORD=… npm run admin:create

# Help center (SET-11/12): shown in the app only when set.
# SUPPORT_CONTACT_EMAIL=
# SUPPORT_CONTACT_HOTLINE=
# LEGAL_TERMS_URL=
# LEGAL_PRIVACY_URL=
# LEGAL_LICENSES_URL=

# New uploads are processed on client; legacy enables transitional server processing.
MEDIA_SERVER_PROCESSING=disabled
