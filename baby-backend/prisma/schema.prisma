  childrenBirthConversionChildrenChildIdFamilyIdTochildren            Child           @relation("birth_conversion_children_child_id_family_idTochildren", fields: [childId, familyId], references: [id, familyId], onDelete: NoAction, onUpdate: NoAction)
  childrenBirthConversionChildrenChildIdFamilyIdPregnancyIdTochildren Child           @relation("birth_conversion_children_child_id_family_id_pregnancy_idTochildren", fields: [childId, familyId, pregnancyId], references: [id, familyId, pregnancyId], onDelete: NoAction, onUpdate: NoAction)
  birthConversion                                                     BirthConversion @relation(fields: [pregnancyId, familyId], references: [pregnancyId, familyId], onDelete: NoAction, onUpdate: NoAction)

