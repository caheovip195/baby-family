  family                                                      Family                 @relation(fields: [familyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pregnanciesBirthConversionsPregnancyIdFamilyIdTopregnancies Pregnancy              @relation("birth_conversions_pregnancy_id_family_idTopregnancies", fields: [pregnancyId, familyId], references: [id, familyId], onDelete: NoAction, onUpdate: NoAction)
  pregnanciesBirthConversionsPregnancyIdTopregnancies         Pregnancy              @relation("birth_conversions_pregnancy_idTopregnancies", fields: [pregnancyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

