// Backend schema. Keep SQL migrations for triggers, checks, views and partial/expression indexes.
generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app", "billing", "ops", "public", "us"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AiUsageMonthly {
  familyId  String    @map("family_id") @db.Uuid
  month     DateTime  @db.Date
  used      Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  family    Family    @relation(fields: [familyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([familyId, month])
  @@map("ai_usage_monthly")
  @@schema("app")
}

model AlbumMemory {
  albumId   String    @map("album_id") @db.Uuid
  memoryId  String    @map("memory_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  addedBy   String    @map("added_by") @db.Uuid
  addedAt   DateTime  @default(now()) @map("added_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  user      User      @relation(fields: [addedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  album     Album     @relation(fields: [albumId, familyId], references: [id, familyId], onDelete: Cascade, onUpdate: NoAction)
  memory    Memory    @relation(fields: [memoryId, familyId], references: [id, familyId], onDelete: Cascade, onUpdate: NoAction)

  @@id([albumId, memoryId])
  @@map("album_memories")
  @@schema("app")
}

model Album {
  id            String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  familyId      String        @map("family_id") @db.Uuid
  ownerUserId   String        @map("owner_user_id") @db.Uuid
  name          String        @db.VarChar(60)
  coverMemoryId String?       @map("cover_memory_id") @db.Uuid
  isSensitive   Boolean       @default(false) @map("is_sensitive")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz(3)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  albumMemories AlbumMemory[]
  memory        Memory?       @relation(fields: [coverMemoryId, familyId], references: [id, familyId], onDelete: NoAction, onUpdate: NoAction)
  family        Family        @relation(fields: [familyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user          User          @relation(fields: [ownerUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id, familyId])
  @@map("albums")
  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AssetVariant {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  familyId       String    @map("family_id") @db.Uuid
  assetId        String    @map("asset_id") @db.Uuid
  variantCode    String    @map("variant_code") @db.VarChar(30)
  storageBucket  String    @map("storage_bucket") @db.VarChar(80)
  storageKey     String    @map("storage_key")
  mime           String    @db.VarChar(80)
  sizeBytes      BigInt    @map("size_bytes")
  width          Int?
  height         Int?
  durationMs     Int?      @map("duration_ms")
  checksumSha256 Bytes?    @map("checksum_sha256")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  asset          Asset     @relation(fields: [assetId, familyId], references: [id, familyId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([assetId, variantCode])
  @@unique([storageBucket, storageKey])
  @@map("asset_variants")
  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Asset {
  id                                            String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  familyId                                      String                   @map("family_id") @db.Uuid
  uploaderUserId                                String                   @map("uploader_user_id") @db.Uuid
  kind                                          AssetKind
  purpose                                       String                   @default("MEMORY") @db.VarChar(20)
  status                                        AssetStatus              @default(PENDING_UPLOAD)
  storageKey                                    String                   @map("storage_key")
  multipartUploadId                             String?                  @map("multipart_upload_id")
  mime                                          String                   @db.VarChar(60)
  declaredSize                                  BigInt                   @map("declared_size")
  sizeBytes                                     BigInt?                  @map("size_bytes")
  width                                         Int?
  height                                        Int?
  durationMs                                    Int?                     @map("duration_ms")
  sha256                                        Bytes?
  capturedAt                                    DateTime?                @map("captured_at") @db.Timestamptz(3)
  blurhash                                      String?                  @db.VarChar(64)
  keepOriginal                                  Boolean                  @default(false) @map("keep_original")
  failureReason                                 String?                  @map("failure_reason") @db.VarChar(60)
  createdAt                                     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  readyAt                                       DateTime?                @map("ready_at") @db.Timestamptz(3)
  deletedAt                                     DateTime?                @map("deleted_at") @db.Timestamptz(3)
  purgeAfter                                    DateTime?                @map("purge_after") @db.Timestamptz(3)
  updatedAt                                     DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  storageBucket                                 String                   @default("bf-media") @map("storage_bucket") @db.VarChar(80)
  privateOwnerUserId                            String?                  @map("private_owner_user_id") @db.Uuid
  assetVariants                                 AssetVariant[]
  familiesAssetsFamilyIdTofamilies              Family                   @relation("assets_family_idTofamilies", fields: [familyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usersAssetsPrivateOwnerUserIdTousers          User?                    @relation("assets_private_owner_user_idTousers", fields: [privateOwnerUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usersAssetsUploaderUserIdTousers              User                     @relation("assets_uploader_user_idTousers", fields: [uploaderUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childrenChildrenAvatarAssetIdFamilyIdToassets Child[]                  @relation("children_avatar_asset_id_family_idToassets")
  childrenChildrenCoverAssetIdFamilyIdToassets  Child[]                  @relation("children_cover_asset_id_family_idToassets")
  familiesFamiliesCoverAssetIdIdToassets        Family[]                 @relation("families_cover_asset_id_idToassets")
  memoryAssets                                  MemoryAsset[]
  memoryPerspectiveAssets                       MemoryPerspectiveAsset[]
  memoryPerspectives                            MemoryPerspective[]
  pregnancies                                   Pregnancy[]
  recaps                                        Recap[]
  storageReservation                            StorageReservation[]
  journalAssets                                 JournalAsset[]

  @@unique([id, familyId])
  @@unique([id, familyId, uploaderUserId])
  @@unique([id, uploaderUserId])
  @@unique([storageBucket, storageKey])
  @@unique([familyId, purpose, privateOwnerUserId, uploaderUserId, sha256], map: "uq_asset_dedup", where: raw("((sha256 IS NOT NULL) AND (deleted_at IS NULL))"))
  @@index([familyId, status])
  @@index([status, createdAt], where: raw("((status = ANY (ARRAY['PENDING_UPLOAD'::app.asset_status, 'UPLOADED'::app.asset_status, 'PROCESSING'::app.asset_status])) AND (deleted_at IS NULL))"))
  @@index([purgeAfter], map: "ix_asset_purge", where: raw("(purge_after IS NOT NULL)"))
  @@map("assets")
  @@schema("app")
}

model AuthIdentity {
  id                      String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                  String       @map("user_id") @db.Uuid
  provider                AuthProvider
  providerUid             String       @map("provider_uid") @db.VarChar(255)
  email                   String?      @db.Citext
  providerRefreshTokenEnc Bytes?       @map("provider_refresh_token_enc")
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt              DateTime?    @map("last_used_at") @db.Timestamptz(3)
  updatedAt               DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?    @map("deleted_at") @db.Timestamptz(3)
  user                    User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([provider, providerUid])
  @@index([userId])
  @@map("auth_identities")
  @@schema("app")
}

model Badge {
  code         String        @id @db.VarChar(30)
  titleI18n    Json          @map("title_i18n")
