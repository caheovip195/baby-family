{
  "name": "baby-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Baby Family backend — NestJS, PostgreSQL, Prisma, three-layer architecture",
  "license": "UNLICENSED",
  "engines": {
    "node": "26.11.x",
    "npm": ">=11.20.0 <12"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "node tools/typescript/build.mjs",
    "start": "npm run build && node dist/main.js",
    "start:dev": "node tools/typescript/dev.mjs",
    "start:debug": "node tools/typescript/dev.mjs --inspect",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/workers/worker.js",
    "lint": "eslint src test --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "compiler:version": "tsc --version && tsc6 --version",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand && npm run test:generator && npm run test:migrations && npm run test:compiler && npm run test:typescript",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.e2e.config.cjs --runInBand",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand",
    "test:generator": "node --test test/generator.test.mjs",
    "test:compiler": "node --test test/compiler-compatibility.test.mjs",
    "test:typescript": "node --test test/typescript-runner.test.mjs",
    "test:compiled": "node --test test/compiled-application.test.mjs",
    "test:migrations": "node --test test/migration-policy.test.mjs",
    "generate": "plop --plopfile plopfile.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:check-migrations": "node tools/database/check-migrations.mjs",
    "db:up": "docker compose --project-directory ../baby-database --file ../baby-database/compose.yaml up -d --wait postgres",
    "db:down": "docker compose --project-directory ../baby-database --file ../baby-database/compose.yaml down",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:verify": "bash test/database-design/validate.sh",
    "generate:persistence": "node tools/database/generate-persistence.mjs",
    "generate:services": "node tools/application/generate-services.mjs",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "check": "npm run prisma:check-migrations && npm run prisma:validate && npm run generate:persistence -- --check && npm run generate:services -- --check && npm run format:check && npm run lint && npm run typecheck && npm run build && npm run test:compiled && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1142.0",
    "@aws-sdk/s3-request-presigner": "3.1142.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "blurhash": "2.0.5",
    "bullmq": "6.3.11",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.7",
    "exifr": "7.1.3",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.0.13",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "overrides": {
    "prisma": {
      "mysql2": "3.24.5"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "5.4.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "plop": "4.0.5",
    "prettier": "3.9.10",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1"
  }
}
