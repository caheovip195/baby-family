# Baby Family app — compile-time values (`--dart-define-from-file=.env`, see `make local-run`).
# Never put secrets here: every value is embedded in the app binary.

# Backend base URL (paths /v1/... are appended). Empty → mock data only.
# iOS simulator: http://localhost:3000/api · Android emulator: http://10.0.2.2:3000/api
BABY_FAMILY_API_URL=http://localhost:3000/api

# Google Sign-In OAuth client ids (public identifiers, not secrets).
GOOGLE_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=

# Mock mode only (ignored when BABY_FAMILY_API_URL is set for sign-in/onboarding).
BABY_FAMILY_MOCK=true
BABY_FAMILY_DEMO=fresh
BABY_FAMILY_ACTOR=mama
