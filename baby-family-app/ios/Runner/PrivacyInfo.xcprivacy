<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  BF-20261028-001 — bản nháp Privacy Manifest của app (docs/05_PHAP_LY_PHAT_HANH.md).
  Không theo dõi, không quảng cáo; dữ liệu thu thập chỉ để vận hành tính năng.
  Required-reason API của Flutter/plugin do manifest riêng của từng plugin khai báo;
  rà lại danh sách này trước khi nộp App Store.
-->
